ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql://cb:cb_secret@localhost/company_brain
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret
SEMAPHORE_LIMIT=5
MCP_PORT=8001
API_PORT=8000
BRAIN_API_HOST_PORT=8080
BRAIN_MCP_HOST_PORT=8001

# --- GitHub ingestion (Layer 1, L1-06) ---
# Personal access token (classic or fine-grained). Required scopes:
#   - public_repo  (read public repos only)        OR
#   - repo         (read private repos as well)
#   - read:org     (recommended, resolves org-scoped author handles)
# Fine-grained tokens need: Repository -> Issues: Read, Pull requests: Read,
# Metadata: Read.  No write permissions are required.
GITHUB_TOKEN=ghp_replace_me
# Comma-separated list of owner/repo slugs to ingest.
GITHUB_REPOS=octocat/Hello-World
# Optional overrides
GITHUB_API_URL=https://api.github.com
GITHUB_PER_PAGE=100
GITHUB_MAX_PAGES=200
