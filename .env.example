# ─── Database ────────────────────────────────────────────────────────────────
# SQLAlchemy async (used by FastAPI app and ORM models)
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
# Service role key — bypasses RLS; used by backend only, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Anon key — safe for client-side use, RLS enforced
SUPABASE_ANON_KEY=eyJ...
# JWT secret — used to verify and sign user JWTs
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Encryption ───────────────────────────────────────────────────────────────
# Key used by pgcrypto to encrypt OAuth tokens and webhook secrets (BYTEA columns)
# Generate with: openssl rand -hex 32
# Move to AWS KMS / GCP KMS before first enterprise customer
ENCRYPTION_KEY=

# ─── AI providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth module (app/, KAN-40) ───────────────────────────────────────────────
ENVIRONMENT=development            # development | test | production
PORT=4000
# Self-issued JWT signing secrets — each must be at least 32 characters.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Comma-separated CORS allowlist (dashboard origins).
ALLOWED_ORIGINS=http://localhost:3000
# External AI service (backend never calls model providers directly).
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
# Transactional email (member invites, auth emails, alerts). Get a key at
# https://resend.com/api-keys. Required — the app fails fast at boot if unset.
RESEND_API_KEY=re_...
# Verified sender for Resend ("Display Name <address@your-domain>").
DEFAULT_FROM_EMAIL=Brainite <founders@brainites.com>
# Public dashboard origin used to build links in emails (e.g. invite acceptance).
APP_BASE_URL=http://localhost:3000

# ─── Source-connection OAuth (read-only knowledge connectors) ──────────────────
# Each provider is optional; leave blank to disable connecting that source.
# GitHub source connections reuse GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET below;
# Google Drive source connections reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET below
# (enable the Drive API on that Google Cloud project, scope drive.readonly).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
# Zendesk OAuth endpoints are per-account: https://{subdomain}.zendesk.com
ZENDESK_SUBDOMAIN=

# ─── Login SSO OAuth ───────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base domain for per-workspace MCP endpoints advertised by GET /settings
# (https://{slug}.{MCP_BASE_DOMAIN}/mcp). Defaults to brainites.com.
MCP_BASE_DOMAIN=brainites.com

# ─── App config ───────────────────────────────────────────────────────────────
API_PORT=8000
MCP_PORT=8001
SEMAPHORE_LIMIT=5
SWEEP_RATE_PER_MINUTE=10
SOURCE_AUTHORITY_PATH=source_authority.yaml
