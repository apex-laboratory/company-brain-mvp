# ─── Database ────────────────────────────────────────────────────────────────
# SQLAlchemy async (used by FastAPI app and ORM models)
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
# Service role key — bypasses RLS; used by backend only, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Anon key — safe for client-side use, RLS enforced
SUPABASE_ANON_KEY=eyJ...
# JWT secret — used to verify and sign user JWTs
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Encryption ───────────────────────────────────────────────────────────────
# Key used by pgcrypto to encrypt OAuth tokens and webhook secrets (BYTEA columns)
# Generate with: openssl rand -hex 32
# Move to AWS KMS / GCP KMS before first enterprise customer
ENCRYPTION_KEY=

# ─── AI providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth module (app/, KAN-40) ───────────────────────────────────────────────
ENVIRONMENT=development            # development | test | production
PORT=4000
# Self-issued JWT signing secrets — each must be at least 32 characters.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Comma-separated CORS allowlist (dashboard/frontend origins). MUST include the
# exact origin the frontend dev server runs on, or credentialed requests (the
# refresh-token cookie needs `credentials: "include"`) are blocked — CORS with
# credentials cannot use a wildcard. Add every FE origin you use, e.g. Vite's
# 5173: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000
# External AI service (backend never calls model providers directly).
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
# Transactional email (member invites, auth emails, alerts). Get a key at
# https://resend.com/api-keys. Required — the app fails fast at boot if unset.
RESEND_API_KEY=re_...
# Verified sender for Resend ("Display Name <address@your-domain>").
DEFAULT_FROM_EMAIL=Brainite <founders@brainites.com>
# Public dashboard origin used to build links in emails (e.g. invite acceptance).
APP_BASE_URL=http://localhost:3000

# ─── Login SSO OAuth (Sign in with Google/GitHub) ──────────────────────────────
# Separate OAuth client registrations from the source-connector ones below —
# different scopes (openid/email/profile) and consent screens.
#
# Login is FRONTEND-driven: the provider redirects the browser to
#   {FRONTEND_URL}{FRONTEND_OAUTH_CALLBACK_PATH}   e.g. http://localhost:3000/auth/callback
# which reads ?code&state and POSTs them to /api/v1/auth/oauth/{provider}/callback.
# Register that FRONTEND URL as the "Authorized redirect URI" in the Google/GitHub
# console (NOT a backend URL). See docs/AUTH_CONTRACT.md §4.
LOGIN_GITHUB_CLIENT_ID=
LOGIN_GITHUB_CLIENT_SECRET=
LOGIN_GOOGLE_CLIENT_ID=
LOGIN_GOOGLE_CLIENT_SECRET=
FRONTEND_OAUTH_CALLBACK_PATH=/auth/callback
# Base domain for per-workspace MCP endpoints advertised by GET /settings
# (https://{slug}.{MCP_BASE_DOMAIN}/mcp). Defaults to brainites.com.
MCP_BASE_DOMAIN=brainites.com

# ─── Source connectors (KAN-2) ────────────────────────────────────────────────
# Public base URL providers redirect back to; callback path is appended:
#   {OAUTH_REDIRECT_BASE_URL}/api/v1/sources/{provider}/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:4000
# Dashboard URL the OAuth callback bounces the browser back to.
FRONTEND_URL=http://localhost:3000
# Notion OAuth app credentials (https://www.notion.so/my-integrations).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# GitHub App (https://github.com/settings/apps). Auth is App-JWT → installation
# tokens. Configure on the App:
#   Callback URL: {OAUTH_REDIRECT_BASE_URL}/api/v1/sources/github/callback
#   Webhook URL:  {OAUTH_REDIRECT_BASE_URL}/api/v1/webhooks/github  (secret below)
#   ✅ Enable "Request user authorization (OAuth) during installation" — required.
#     The callback code is exchanged for a user token to verify the installer actually
#     controls the installation_id (blocks cross-tenant binding of foreign installs).
# GITHUB_APP_PRIVATE_KEY is the .pem contents on one line with newlines as \n.
# GITHUB_APP_CLIENT_ID/SECRET are the App's OAuth client credentials (shown on the
# App settings page; distinct from the numeric App ID).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Google (Drive + Gmail) — one OAuth client serves both providers
# (https://console.cloud.google.com/apis/credentials). On the OAuth client set the
# Authorized redirect URIs to BOTH callbacks:
#   {OAUTH_REDIRECT_BASE_URL}/api/v1/sources/google_drive/callback
#   {OAUTH_REDIRECT_BASE_URL}/api/v1/sources/gmail/callback
# Keep the OAuth consent screen in "Testing" status (<=100 users) to skip Google
# verification. Enable the Drive API + Gmail API on the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail push notifications (Cloud Pub/Sub). Create a topic, grant publish to
# gmail-api-push@system.gserviceaccount.com, and add a push subscription whose
# endpoint is {OAUTH_REDIRECT_BASE_URL}/api/v1/webhooks/gmail?token=<the token below>.
# Drive push uses HTTPS watch channels (no Pub/Sub) and needs no extra config here.
GOOGLE_PUBSUB_TOPIC=          # projects/<project>/topics/<topic>
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# ─── App config ───────────────────────────────────────────────────────────────
API_PORT=8000
MCP_PORT=8001
SEMAPHORE_LIMIT=5
SWEEP_RATE_PER_MINUTE=10
SOURCE_AUTHORITY_PATH=source_authority.yaml
